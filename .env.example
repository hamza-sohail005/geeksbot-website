# EmailJS settings used by components/ContactForm.js
# Copy this file to ".env.local" and fill in real values (never commit .env.local)
# Get these from your EmailJS dashboard: https://dashboard.emailjs.com/admin

# Account > Email Services > (your connected Gmail service)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx

# Email Templates > (admin notification template - sends to geeksbotdev@gmail.com)
NEXT_PUBLIC_EMAILJS_ADMIN_TEMPLATE_ID=template_xxxxxxx

# Email Templates > (auto-reply template - sends back to whoever filled the form)
NEXT_PUBLIC_EMAILJS_AUTOREPLY_TEMPLATE_ID=template_xxxxxxx

# Account > General > Public Key
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your-public-key

# ===== Geek AI Assistant (Groq) =====
# Get a free key at https://console.groq.com (Groq Cloud > API Keys)
# Server-only — do NOT prefix with NEXT_PUBLIC_. Read only inside
# app/api/chat/route.js (a Route Handler), never shipped to the browser.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== Geek's voice (ElevenLabs, optional) =====
# Free tier is NOT commercially licensed (verified against elevenlabs.io/pricing -
# "Commercial License" only appears from the $6/mo Starter plan up). If this key
# is on the free tier, Geek still works fine - lib/speak.js falls back to the
# browser's built-in voice automatically on any ElevenLabs failure/quota limit.
# Get a key at https://elevenlabs.io (Settings > API Keys). Server-only.
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Pick any voice_id from https://elevenlabs.io/app/voice-library or GET /v1/voices
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
